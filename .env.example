# FinSight AI — LLM provider keys (never commit real keys).
# Copy to ".env" and fill in. At least one provider enables live AI answers;
# with no key set, FinSight runs in deterministic demo mode.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# xAI Grok — https://console.x.ai/
GROK_API_KEY=
# GROK_MODEL=grok-3-mini

# Force a provider: auto | gemini | openai | anthropic | grok | demo (default: auto)
# LLM_PROVIDER=auto
